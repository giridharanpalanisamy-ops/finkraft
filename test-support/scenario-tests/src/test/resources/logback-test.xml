<configuration>
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>build/scenario.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%X{invoice_id:-}] [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="com.finkraft" level="INFO"/>
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.springframework.kafka" level="WARN"/>
    <root level="WARN">
        <appender-ref ref="FILE"/>
    </root>
</configuration>
